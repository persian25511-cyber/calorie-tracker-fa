# ─────────────────────────────────────────────────────────────
# کالری‌شمار روزمره — نمونه متغیرهای محیطی
# This app is local-first: NO secrets or backend keys are required.
# All user data stays in the browser localStorage.
# ─────────────────────────────────────────────────────────────

# Optional: title shown in the document title (fallback: کالری‌شمار روزمره)
VITE_APP_NAME=کالری‌شمار روزمره

# Railway injects PORT automatically at runtime. It is documented here only
# so local Docker/Railpack runs can mirror production. Vercel ignores it.
PORT=4173

# Do NOT put GITHUB_TOKEN, TELEGRAM_BOT_TOKEN or any other secret here.
# Vite exposes every VITE_* variable to the browser bundle.
